# Copy to `.env` on the Raspberry Pi (next to docker-compose.yml) and fill in.

# Postgres (container is created with these on first start)
POSTGRES_USER=webtrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=webtrack

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The URL you open the app at, e.g. http://raspberrypi.local:3000 or https://track.example.com
BETTER_AUTH_URL=http://raspberrypi.local:3000

NEXT_PUBLIC_HOST_URL=http://raspberrypi.local:3000

# Host port the app is published on
APP_PORT=3000
